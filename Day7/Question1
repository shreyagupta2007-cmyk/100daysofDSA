#include<stdio.h>
int fib(int n)
{
    int a=0;
    int b=1;
    int sum=0;
    if(n==0)
    {
        return 0;
    }
    if(n==1)
        return 1;
    else
    {
        for(int i=0;i<n-1;i++)
        {
            sum=a+b;
            a=b;
            b=sum;
        }
    }
    return sum;
}
int main()
{
    int n;
    printf("Enter the term:");
    scanf("%d", &n);
    printf("Fibonacci number:%d", fib(n));
    return 0;
}
